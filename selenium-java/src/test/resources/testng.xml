    <listener class-name="utils.ServerBootstrapListener"/>
  </listeners>
  <test name="API Tests">
    <classes>
      <class name="tests.api.HealthApiTest"/>
    </classes>
  </test>
  <test name="UI Tests">
    <classes>
      <class name="tests.ui.UploadTest"/>
    </classes>
  </test>
</suite>
